# Supabase Configuration
# Obtain these from your Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile Bot Protection
# Obtain from Cloudflare Dashboard > Turnstile
NEXT_PUBLIC_TURNSTILE_SITEKEY=0x4AAAAAA...
TURNSTILE_SECRET=0x4AAAAAA...
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,brahamjot.dev,www.brahamjot.dev
